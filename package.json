{
  "name": "party-invite",
  "version": "1.0.0",
  "description": "Party invite manager for macOS menu bar",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder && cp dist/*.dmg ../catalog/public/downloads/PartyInvite.dmg",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "electron-store": "^8.2.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.7.3",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.m42.party-invite",
    "productName": "Party Invite",
    "afterPack": "afterPack.js",
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 360,
          "type": "file",
          "path": "resources/Open Anyway.command"
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ]
  }
}
